<section class="section" style="padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width" style="max-width:760px">
    <div class="flex-between" style="margin-bottom:2rem">
      <h1 class="h2" style="margin:0">Your addresses</h1>
      <a href="{{ routes.account_url }}" class="btn btn--secondary">Back to account</a>
    </div>

    {%- paginate customer.addresses by 5 -%}
      {%- for address in customer.addresses -%}
        <div style="border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:1.25rem;margin-bottom:1rem">
          {%- if address == customer.default_address -%}<span class="badge badge--new" style="margin-bottom:.5rem">Default</span>{%- endif -%}
          <p style="margin:0">{{ address | format_address }}</p>
        </div>
      {%- else -%}
        <p class="text-muted">No saved addresses yet.</p>
      {%- endfor -%}
    {%- endpaginate -%}

    <details style="margin-top:1.5rem">
      <summary class="btn btn--primary" style="display:inline-block">Add a new address</summary>
      {%- form 'customer_address', customer.new_address, class: 'mt-3' -%}
        <div class="grid-2" style="gap:.75rem">
          <input type="text" name="address[first_name]" placeholder="First name" class="acct-input">
          <input type="text" name="address[last_name]" placeholder="Last name" class="acct-input">
        </div>
        <input type="text" name="address[address1]" placeholder="Address" class="acct-input" style="margin-top:.75rem">
        <div class="grid-2" style="gap:.75rem;margin-top:.75rem">
          <input type="text" name="address[city]" placeholder="City" class="acct-input">
          <input type="text" name="address[zip]" placeholder="ZIP / Postal" class="acct-input">
        </div>
        <input type="text" name="address[country]" placeholder="Country" class="acct-input" style="margin-top:.75rem">
        <button type="submit" class="btn btn--primary mt-2">Save address</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% style %}.acct-input{width:100%;background:var(--color-surface);border:1px solid var(--color-border);color:#fff;border-radius:var(--radius);padding:.9rem 1.1rem}.acct-input:focus{outline:none;border-color:var(--color-accent)}{% endstyle %}

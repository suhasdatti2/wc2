<section class="section" style="padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width" style="max-width:440px">
    <header class="text-center" style="margin-bottom:2rem">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="h2">Activate your account</h1>
      <p class="text-muted">Create a password to activate your account.</p>
    </header>
    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" placeholder="Password" required aria-label="Password" class="acct-input">
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required aria-label="Confirm password" class="acct-input" style="margin-top:.75rem">
      <button type="submit" class="btn btn--primary btn--full mt-2">Activate account</button>
      <button type="submit" name="decline" class="link-underline text-muted mt-2" style="display:block;margin-inline:auto;background:none">Decline invitation</button>
    {%- endform -%}
  </div>
</section>
{% style %}.acct-input{width:100%;background:var(--color-surface);border:1px solid var(--color-border);color:#fff;border-radius:var(--radius);padding:.9rem 1.1rem}.acct-input:focus{outline:none;border-color:var(--color-accent)}{% endstyle %}

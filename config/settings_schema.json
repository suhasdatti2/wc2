[
  {
    "name": "theme_info",
    "theme_name": "Novora",
    "theme_version": "1.0.0",
    "theme_author": "Novora",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Optional. Leave blank to use the text logo."
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logo text",
        "default": "NOVORA"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "textarea",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "Wear Your Passion. Represent Your Colors."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand palette"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / cards",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#A1A1A1"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Gold)",
        "default": "#D4AF37"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Highlight (Electric Blue)",
        "default": "#00C2FF"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#262626"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Primary button text",
        "default": "#0A0A0A"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 110
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body size scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 40,
        "max": 140,
        "step": 4,
        "unit": "px",
        "label": "Spacing between sections",
        "default": 96
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 8
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_style",
        "label": "Button shape",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "rounded", "label": "Rounded" },
          { "value": "pill", "label": "Pill" }
        ],
        "default": "pill"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable slide-out cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "free_shipping_bar_enabled",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "$",
        "label": "Free shipping threshold",
        "default": 120
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Cart upsell collection",
        "info": "Products recommended inside the cart drawer."
      }
    ]
  },
  {
    "name": "Product page",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_sticky_atc",
        "label": "Enable sticky Add to Cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_low_stock",
        "label": "Show low stock indicator",
        "default": true
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "min": 1,
        "max": 50,
        "step": 1,
        "label": "Low stock threshold",
        "default": 12
      },
      {
        "type": "checkbox",
        "id": "enable_visitor_counter",
        "label": "Show live visitor counter",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_recent_purchases",
        "label": "Show recent purchase notifications",
        "default": true
      }
    ]
  },
  {
    "name": "Navigation",
    "settings": [
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "link_list",
        "id": "footer_menu",
        "label": "Footer menu",
        "default": "footer"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_twitter", "label": "X / Twitter URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
    ]
  }
]

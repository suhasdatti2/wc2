<div class="collection-hero">
  <div class="page-width">
    <p class="eyebrow" data-reveal>Journal</p>
    <h1 class="h1" data-reveal>{{ blog.title }}</h1>
  </div>
</div>
<section class="section" style="padding-top:0">
  <div class="page-width">
    <div class="product-grid">
      {%- for article in blog.articles -%}
        <article class="product-card" data-reveal>
          <a href="{{ article.url }}" class="product-card__media" style="aspect-ratio:16/10">
            {%- if article.image -%}
              <img class="product-card__img media-fade" src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" width="700" height="438" loading="lazy">
            {%- else -%}{{ 'image' | placeholder_svg_tag: 'product-card__img' }}{%- endif -%}
          </a>
          <div class="product-card__body">
            <div class="product-card__team">{{ article.published_at | date: '%b %d, %Y' }}</div>
            <h3 class="product-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="text-muted" style="font-size:.9rem">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Blog posts", "tag": "section", "settings": [] }
{% endschema %}

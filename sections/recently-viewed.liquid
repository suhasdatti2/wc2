<section class="section" data-section-type="recently-viewed" data-recently-viewed-section>
  <div class="page-width">
    <div class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="product-grid" data-recently-viewed></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pick Up Where You Left Off" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently Viewed" }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}

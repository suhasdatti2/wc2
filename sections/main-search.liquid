<section class="section" style="padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width">
    <header class="text-center" style="margin-bottom:2.5rem">
      <p class="eyebrow">{{ 'general.search.search' | t }}</p>
      <h1 class="h2">
        {%- if search.performed -%}{{ 'general.search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'templates.search.title' | t }}{%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:.6rem;max-width:560px;margin:1.5rem auto 0">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}"
          style="flex:1;background:var(--color-surface);border:1px solid var(--color-border);color:#fff;border-radius:999px;padding:0 1.2rem;height:54px" aria-label="{{ 'general.search.search' | t }}">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn btn--primary">{{ 'general.search.search' | t }}</button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, show_team: true %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="text-center text-muted">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "tag": "section", "settings": [] }
{% endschema %}

{%- liquid
  assign related = product.collections.first.products | default: collections.all.products
-%}
<section class="section" data-section-type="related">
  <div class="page-width">
    <div class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="product-grid">
      {%- assign shown = 0 -%}
      {%- for p in related -%}
        {%- if p.id != product.id and shown < section.settings.products_to_show -%}
          {% render 'product-card', product: p, show_team: true %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You May Also Like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete The Look" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}

<section class="hero" data-section-type="hero">
  <div class="hero__media" {% if section.settings.enable_parallax %}data-parallax{% endif %}>
    {%- if section.settings.video != blank -%}
      <video autoplay muted loop playsinline poster="{{ section.settings.image | image_url: width: 1600 }}">
        <source src="{{ section.settings.video.sources[1].url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape | default: 'Novora football jerseys' }}"
        width="2000" height="1125" fetchpriority="high">
    {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#0A0A0A,#161616 60%,#001a24)"></div>
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>

  <div class="hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow hero__eyebrow hero-anim hero-anim--1">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="hero__title h1 hero-anim hero-anim--2">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subtitle hero-anim hero-anim--3">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hero__actions hero-anim hero-anim--4">
      {%- if section.settings.button_1_label != blank -%}
        <a href="{{ section.settings.button_1_link }}" class="btn btn--primary btn--lg">{{ section.settings.button_1_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a href="{{ section.settings.button_2_link }}" class="btn btn--secondary btn--lg">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll -%}
    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <span class="hero__scroll-line"></span>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "video", "id": "video", "label": "Background video (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium Football Jerseys" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Represent Your Colors." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Premium football jerseys inspired by the world's biggest matches." },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop Jerseys" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "Best Sellers" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "checkbox", "id": "enable_parallax", "label": "Enable parallax", "default": true },
    { "type": "checkbox", "id": "show_scroll", "label": "Show scroll indicator", "default": true }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

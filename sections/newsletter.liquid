<section class="section newsletter" data-section-type="newsletter">
  <div class="page-width">
    <div class="newsletter__inner" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="text-muted">{{ section.settings.text }}</p>{%- endif -%}

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required aria-label="{{ 'general.newsletter.label' | t }}">
        <button type="submit" class="btn btn--primary">{{ section.settings.button_label }}</button>
        {%- if form.posted_successfully? -%}
          <p class="newsletter__note" style="color:var(--color-highlight)">{{ 'general.newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.note != blank -%}<p class="newsletter__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join The Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% Off Your First Order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be first to access limited drops, restocks, and members-only offers." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Fine print", "default": "No spam. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

<div class="collection-hero">
  <div class="page-width">
    <p class="eyebrow" data-reveal>Browse</p>
    <h1 class="h1" data-reveal>{{ section.settings.heading | default: 'All Collections' }}</h1>
  </div>
</div>
<section class="section" style="padding-top:0">
  <div class="page-width">
    <div class="team-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="team-card" data-reveal>
          {%- if collection.featured_image -%}
            <img class="team-card__img media-fade" src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" width="600" height="800" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'team-card__img' }}
          {%- endif -%}
          <span class="team-card__overlay"></span>
          <div class="team-card__body">
            <div class="team-card__name">{{ collection.title }}</div>
            <div class="team-card__count">{{ collection.products_count }} products</div>
            <span class="team-card__cta">Shop Now {% render 'icon', name: 'arrow-right', width: 18, height: 18 %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Collections" }
  ]
}
{% endschema %}

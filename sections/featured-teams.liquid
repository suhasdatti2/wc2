<section class="section" data-section-type="featured-teams">
  <div class="page-width">
    <div class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="team-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = collections[block.settings.collection]
          assign img = block.settings.image
          if img == blank and collection != blank
            assign img = collection.featured_image
          endif
        -%}
        <a href="{{ collection.url | default: block.settings.link | default: '#' }}" class="team-card" data-reveal {{ block.shopify_attributes }}>
          <span class="team-card__accent" style="background:linear-gradient(90deg,{{ block.settings.accent_1 }} 0 33%,{{ block.settings.accent_2 }} 33% 66%,{{ block.settings.accent_3 }} 66% 100%)"></span>
          {%- if img != blank -%}
            <img class="team-card__img media-fade" src="{{ img | image_url: width: 600 }}"
              srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w"
              sizes="(max-width:749px) 50vw, 25vw"
              alt="{{ block.settings.title | escape }}" width="600" height="800" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'team-card__img' }}
          {%- endif -%}
          <span class="team-card__overlay"></span>
          <div class="team-card__body">
            <div class="team-card__name">{{ block.settings.title | default: collection.title }}</div>
            <div class="team-card__count">
              {%- if collection != blank -%}{{ collection.products_count }} products{%- else -%}{{ block.settings.subtitle }}{%- endif -%}
            </div>
            <span class="team-card__cta">Shop Now {% render 'icon', name: 'arrow-right', width: 18, height: 18 %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured teams",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured Teams" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Represent Your Nation" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Country-inspired collections crafted for the global game." }
  ],
  "blocks": [
    {
      "type": "team",
      "name": "Team / Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Brazil" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Home & Away" },
        { "type": "url", "id": "link", "label": "Link (if no collection)" },
        { "type": "header", "content": "Flag accent" },
        { "type": "color", "id": "accent_1", "label": "Accent 1", "default": "#009C3B" },
        { "type": "color", "id": "accent_2", "label": "Accent 2", "default": "#FFDF00" },
        { "type": "color", "id": "accent_3", "label": "Accent 3", "default": "#002776" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured teams",
      "blocks": [
        { "type": "team", "settings": { "title": "Brazil", "accent_1": "#009C3B", "accent_2": "#FFDF00", "accent_3": "#002776" } },
        { "type": "team", "settings": { "title": "Argentina", "accent_1": "#74ACDF", "accent_2": "#FFFFFF", "accent_3": "#74ACDF" } },
        { "type": "team", "settings": { "title": "France", "accent_1": "#0055A4", "accent_2": "#FFFFFF", "accent_3": "#EF4135" } },
        { "type": "team", "settings": { "title": "Portugal", "accent_1": "#006600", "accent_2": "#FF0000", "accent_3": "#FFD700" } }
      ]
    }
  ]
}
{% endschema %}

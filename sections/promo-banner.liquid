<section class="section" data-section-type="promo">
  <div class="page-width">
    <div class="promo-banner" data-reveal>
      <div class="promo-banner__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1600 }}"
            srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
            sizes="(max-width:1400px) 100vw, 1400px"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" width="1600" height="700" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:linear-gradient(120deg,#0A0A0A,#1a1a1a 60%,#002736)"></div>
        {%- endif -%}
      </div>
      <div class="promo-banner__overlay"></div>
      <div class="promo-banner__content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h1" style="font-size:clamp(2rem,4vw,3.4rem)">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p style="color:rgba(255,255,255,.82);max-width:440px">{{ section.settings.text }}</p>{%- endif -%}

        {%- if section.settings.show_countdown -%}
          <div class="countdown" data-countdown="{{ section.settings.countdown_date }}">
            <div class="countdown__unit"><div class="countdown__num" data-cd="days">00</div><div class="countdown__label">Days</div></div>
            <div class="countdown__unit"><div class="countdown__num" data-cd="hours">00</div><div class="countdown__label">Hours</div></div>
            <div class="countdown__unit"><div class="countdown__num" data-cd="mins">00</div><div class="countdown__label">Mins</div></div>
            <div class="countdown__unit"><div class="countdown__num" data-cd="secs">00</div><div class="countdown__label">Secs</div></div>
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The World Cup Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Celebrate the world's biggest stage with our limited-edition kits. While stocks last." },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "text", "id": "countdown_date", "label": "Countdown end (YYYY-MM-DD HH:MM)", "info": "Leave blank for a rolling 72-hour timer.", "default": "" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Drop" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}

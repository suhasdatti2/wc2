<section class="section" style="padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width" style="max-width:840px">
    <header class="text-center" data-reveal style="margin-bottom:3rem">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="h1">{{ page.title }}</h1>
    </header>
    <div class="rte" data-reveal style="font-size:1.05rem;line-height:1.8;color:var(--color-muted)">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Page", "tag": "section", "settings": [] }
{% endschema %}

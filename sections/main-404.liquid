<section class="section" style="min-height:70vh;display:grid;place-items:center;text-align:center;padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width">
    <p class="eyebrow">404</p>
    <h1 class="h1 text-gradient">{{ 'templates.404.title' | t }}</h1>
    <p class="text-muted" style="max-width:440px;margin:1rem auto 2rem">{{ 'templates.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg">{{ 'templates.404.cta' | t }}</a>
  </div>
</section>

{% schema %}
{ "name": "404", "tag": "section", "settings": [] }
{% endschema %}

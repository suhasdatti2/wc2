{%- paginate collection.products by section.settings.products_per_page -%}
<div class="collection-hero">
  <div class="page-width">
    <p class="eyebrow" data-reveal>Collection</p>
    <h1 class="h1" data-reveal>{{ collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}
      <p class="text-muted" data-reveal style="max-width:620px;margin:1rem auto 0">{{ collection.description }}</p>
    {%- endif -%}
  </div>
</div>

<section class="section" style="padding-top:0">
  <div class="page-width">
    <div class="collection-toolbar">
      <span class="collection-count">{{ collection.products_count }} products</span>
      {%- if section.settings.show_sorting -%}
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <form>
          <label class="visually-hidden" for="SortBy">Sort</label>
          <select id="SortBy" name="sort_by" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
          {%- endfor -%}
        </form>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, show_team: true %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="text-center mt-4" style="display:flex;gap:.5rem;justify-content:center;align-items:center" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--secondary">{% render 'icon', name:'chevron-left', width:18,height:18 %}</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="header-icon" style="border:1px solid var(--color-border)">{{ part.title }}</a>
            {%- else -%}
              <span class="header-icon" style="background:var(--color-accent);color:#000">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--secondary">{% render 'icon', name:'chevron-right', width:18,height:18 %}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="cart-empty">
        <p class="h3">No products found</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary mt-2">Browse all jerseys</a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 16 },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "checkbox", "id": "show_sorting", "label": "Show sorting", "default": true }
  ]
}
{% endschema %}

<section class="hero" style="margin-top:0">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="" width="2000" height="1125" fetchpriority="high">
    {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#0A0A0A,#161616 60%,#001a24)"></div>
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__content page-width text-center" style="margin:0 auto;max-width:560px">
    <div class="site-logo hero-anim hero-anim--1" style="font-size:2rem;margin-bottom:1rem">{{ settings.logo_text | default: 'NOVORA' }}</div>
    <h1 class="h1 hero-anim hero-anim--2">{{ section.settings.heading }}</h1>
    <p class="hero__subtitle hero-anim hero-anim--3" style="margin-inline:auto">{{ section.settings.text }}</p>

    <div class="hero-anim hero-anim--4" style="max-width:420px;margin:0 auto">
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="prelaunch">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required aria-label="Email">
        <button type="submit" class="btn btn--primary">Notify Me</button>
        {%- if form.posted_successfully? -%}<p class="newsletter__note" style="color:var(--color-highlight)">You're on the list!</p>{%- endif -%}
      {%- endform -%}

      <details style="margin-top:2rem">
        <summary class="link-underline" style="cursor:pointer;display:inline-block">Enter using password</summary>
        {%- form 'storefront_password', class: 'newsletter__form', style: 'margin-top:1rem' -%}
          <input type="password" name="password" placeholder="Password" aria-label="Password">
          <button type="submit" class="btn btn--secondary">Enter</button>
        {%- endform -%}
        {%- if form.errors -%}<p class="newsletter__note" style="color:#ff5252">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>{%- endif -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something Big Is Coming" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Novora is launching soon. Be first to wear your colors." }
  ]
}
{% endschema %}

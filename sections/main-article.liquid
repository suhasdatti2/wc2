<article class="section" style="padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width" style="max-width:820px">
    <header class="text-center" data-reveal style="margin-bottom:2rem">
      <p class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <h1 class="h1">{{ article.title }}</h1>
      {%- if article.author != blank -%}<p class="text-muted">By {{ article.author }}</p>{%- endif -%}
    </header>
    {%- if article.image -%}
      <div data-reveal style="border-radius:var(--radius-lg);overflow:hidden;margin-bottom:2.5rem">
        <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" width="1400" height="700" loading="eager">
      </div>
    {%- endif -%}
    <div class="rte" data-reveal style="font-size:1.08rem;line-height:1.85">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article", "tag": "section", "settings": [] }
{% endschema %}

<section class="section" style="padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width" style="max-width:680px">
    <header class="text-center" data-reveal style="margin-bottom:2.5rem">
      <p class="eyebrow">{{ 'templates.contact.title' | t }}</p>
      <h1 class="h2">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="text-muted">{{ section.settings.text }}</p>{%- endif -%}
    </header>

    {%- form 'contact', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p style="background:rgba(0,194,255,.1);border:1px solid var(--color-highlight);border-radius:var(--radius);padding:1rem;color:var(--color-highlight)">Thanks! We'll be in touch shortly.</p>
      {%- endif -%}
      <div class="grid-2" style="margin-bottom:1rem">
        <input type="text" name="contact[name]" placeholder="Name" required aria-label="Name" class="contact-input">
        <input type="email" name="contact[email]" placeholder="Email" required aria-label="Email" class="contact-input">
      </div>
      <input type="text" name="contact[subject]" placeholder="Subject" aria-label="Subject" class="contact-input" style="margin-bottom:1rem">
      <textarea name="contact[body]" placeholder="Your message" rows="6" required aria-label="Message" class="contact-input" style="margin-bottom:1.25rem"></textarea>
      <button type="submit" class="btn btn--primary btn--lg">Send message</button>
    {%- endform -%}
  </div>
</section>

{% style %}
  .contact-input { width:100%; background:var(--color-surface); border:1px solid var(--color-border); color:var(--color-text); border-radius:var(--radius); padding:0.9rem 1.1rem; }
  .contact-input:focus { outline:none; border-color:var(--color-accent); }
{% endstyle %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get In Touch" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about sizing, shipping or an order? Our team replies within 24 hours." }
  ]
}
{% endschema %}

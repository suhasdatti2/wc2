<section class="section" style="padding-top:calc(var(--header-height) + 2rem)">
  <div class="page-width" style="max-width:980px">
    <h1 class="h2" data-reveal>{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- if settings.free_shipping_bar_enabled and settings.free_shipping_threshold > 0 -%}
        {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
        {%- assign remaining = threshold | minus: cart.total_price -%}
        <div class="ship-bar" data-reveal style="margin:1.5rem 0 2rem">
          <div class="ship-bar__text">
            {%- if remaining > 0 -%}You're <strong>{{ remaining | money }}</strong> away from free shipping{%- else -%}🎉 You've unlocked free shipping!{%- endif -%}
          </div>
          <div class="ship-bar__track"><div class="ship-bar__fill" style="width:{% if remaining > 0 %}{{ cart.total_price | times: 100 | divided_by: threshold }}{% else %}100{% endif %}%"></div></div>
        </div>
      {%- endif -%}

      <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        <div data-reveal>
          {%- for item in cart.items -%}
            <div class="cart-line" style="grid-template-columns:90px 1fr auto;padding:1.25rem 0">
              <div class="cart-line__img"><a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.product.title | escape }}" width="90" height="112" loading="lazy"></a></div>
              <div>
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<div class="cart-line__variant">{{ item.variant.title }}</div>{%- endunless -%}
                <div class="qty" data-cart-page-qty>
                  <a href="{{ item.url_to_remove }}" class="qty-link" aria-label="Decrease" data-qty-step data-line="{{ forloop.index }}" data-to="{{ item.quantity | minus: 1 }}" style="width:32px;height:32px;display:grid;place-items:center">−</a>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" style="width:46px;text-align:center;background:transparent;border:0;color:#fff">
                  <a href="{{ item.url }}" class="qty-link" aria-label="Increase" data-qty-step data-line="{{ forloop.index }}" data-to="{{ item.quantity | plus: 1 }}" style="width:32px;height:32px;display:grid;place-items:center">+</a>
                </div>
              </div>
              <div style="text-align:right">
                <div class="cart-line__price" style="font-weight:700">{{ item.final_line_price | money }}</div>
                <a href="{{ item.url_to_remove }}" class="cart-line__remove">{{ 'cart.remove' | t }}</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="flex-between" style="flex-wrap:wrap;gap:1.5rem;margin-top:2rem">
          <button type="submit" name="update" class="btn btn--secondary">Update cart</button>
          <div style="text-align:right;min-width:240px">
            <div class="cart-subtotal" style="font-size:1.4rem">
              <span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span>
            </div>
            <p class="text-muted" style="font-size:.82rem">{{ 'cart.taxes_shipping' | t }}</p>
            <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg mt-2">{{ 'cart.checkout' | t }}</button>
            {%- if additional_checkout_buttons -%}<div class="cart-express mt-2">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <p class="h3">{{ 'cart.empty' | t }}</p>
        <p class="text-muted">Time to represent your colors.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary mt-2">{{ 'cart.empty_cta' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "tag": "section", "settings": [] }
{% endschema %}

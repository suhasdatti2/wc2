<section class="section" data-section-type="social">
  <div class="page-width">
    <div class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.handle != blank -%}<p>{{ section.settings.handle }}</p>{%- endif -%}
    </div>

    <div class="social-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}" class="social-tile" data-reveal target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img class="media-fade" src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="400" height="400">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="social-tile__icon">{% render 'icon', name: 'instagram', width: 28, height: 28 %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Social" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "#WearNovora" },
    { "type": "text", "id": "handle", "label": "Subtext", "default": "Tag us to be featured. Join the movement." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'cart' %}
  Optional: width / height (defaults inherit from CSS)
{%- endcomment -%}
{%- liquid
  assign w = width | default: 24
  assign h = height | default: 24
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
  {%- when 'user' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
  {%- when 'chevron-down' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-left' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
  {%- when 'chevron-right' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.8 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8Z"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h1"/><path d="M14 9h4l4 4v4a1 1 0 0 1-1 1h-1"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
  {%- when 'refresh' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
  {%- when 'medal' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 2 12 9l4.5-7"/><path d="M9 2 12 7 15 2"/><circle cx="12" cy="15" r="6"/><path d="m12 12 1.2 2.4 2.6.4-1.9 1.8.5 2.6L12 18l-2.4 1.2.5-2.6-1.9-1.8 2.6-.4Z"/></svg>
  {%- when 'globe' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
  {%- when 'check-circle' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
  {%- when 'flame' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="currentColor" aria-hidden="true"><path d="M12 2c1 3 4 4 4 8a4 4 0 0 1-8 0c0-1 .3-1.8.7-2.5C8 8.5 8 7 8 6c2 1 2.5 2 3 3 .8-1.6 1-4 1-7Z"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="currentColor" aria-hidden="true"><path d="M16 3c.3 2.2 1.7 3.9 4 4.2v3c-1.5 0-2.9-.4-4-1.1V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1c-.3-.1-.7-.2-1-.2a3 3 0 1 0 3 3V3Z"/></svg>
  {%- when 'twitter' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="currentColor" aria-hidden="true"><path d="M18.2 2H21l-6.5 7.5L22 22h-6l-4.7-6.1L5.9 22H3l7-8L2 2h6.2l4.3 5.6Zm-1 18h1.6L7.1 3.6H5.4Z"/></svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.3-.4-4.8a2.5 2.5 0 0 0-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.4a2.5 2.5 0 0 0-1.8 1.8C1 8.7 1 12 1 12s0 3.3.4 4.8a2.5 2.5 0 0 0 1.8 1.8C4.7 19 12 19 12 19s7.3 0 8.8-.4a2.5 2.5 0 0 0 1.8-1.8C23 15.3 23 12 23 12ZM10 15V9l5 3Z"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/></svg>
  {%- when 'zoom' -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" width="{{ w }}" height="{{ h }}" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
{%- endcase -%}
